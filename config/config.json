# config.json
# -----------
# Configuration file for the Multi-Cloud Platform prototype.
# Edit this file to change provider credentials, server settings,
# and simulation storage paths.
#
# In a production deployment the credentials would be replaced
# with real OAuth2 tokens / API keys obtained from each provider's
# developer console.

{
  "server": {
    "host": "0.0.0.0",
    "port": 5000,
    "debug": true,
    "max_upload_mb": 500
  },

  "database": {
    "path": "multicloud.db"
  },

  "providers": {
    "google_drive": {
      "enabled": true,
      "display_name": "Google Drive",
      "storage_root": "sim_google",
      "credentials": {
        "api_key": "YOUR_GOOGLE_API_KEY_HERE"
      },
      "quota_bytes": 16106127360
    },
    "onedrive": {
      "enabled": true,
      "display_name": "Microsoft OneDrive",
      "storage_root": "sim_onedrive",
      "credentials": {
        "client_id": "YOUR_AZURE_CLIENT_ID_HERE",
        "client_secret": "YOUR_AZURE_CLIENT_SECRET_HERE"
      },
      "quota_bytes": 5368709120
    }
  },

  "transfer": {
    "temp_dir": null,
    "checksum_verify": true
  }
}
